# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# Public values (exposed to the browser) must start with NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME="CivicTrack"

# Server-only secrets (never prefix these with NEXT_PUBLIC_).
# Optional. Without a key the app uses the built-in rule-based analysis.
ANTHROPIC_API_KEY=

# Officer area (/admin). Required to use it: the area stays locked until ADMIN_PASSWORD is
# set to at least 12 characters. ADMIN_USERNAME defaults to "officer".
ADMIN_USERNAME=officer
ADMIN_PASSWORD=

# Satellite imagery from Google Earth Engine (optional). Without these, the officer map shows
# the OpenStreetMap street map only. Needs a Google Cloud project registered with Earth Engine
# and a service-account key file. Keep the key out of the repository: secrets/ is git-ignored.
GOOGLE_EARTH_ENGINE_PROJECT=
GOOGLE_EARTH_ENGINE_KEY_FILE=secrets/earth-engine-key.json
