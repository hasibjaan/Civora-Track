# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# Every setting here is server-only. Never prefix one with NEXT_PUBLIC_: that would send it to
# the browser.
# Optional. Without a key the app uses the built-in rule-based analysis.
ANTHROPIC_API_KEY=

# Officer area (/admin). Required to use it: the area stays locked until ADMIN_PASSWORD is
# set to at least 12 characters. ADMIN_USERNAME defaults to "officer".
ADMIN_USERNAME=officer
ADMIN_PASSWORD=

# Shared storage in Supabase, so every device sees the same reports. Required on Vercel.
# Leave both empty to keep data in data/ on this computer. See docs/DEPLOY.md.
# SUPABASE_URL is the project URL. SUPABASE_SECRET_KEY is a secret key (sb_secret_...), never
# the publishable key. The secret key bypasses row level security: keep it on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Satellite imagery from Google Earth Engine (optional). Without these, the officer map shows
# the OpenStreetMap street map only. Needs a Google Cloud project registered with Earth Engine
# and a service-account key. Locally, point to the key file (secrets/ is git-ignored). On hosts
# without your own files, such as Vercel, paste the key's JSON into GOOGLE_EARTH_ENGINE_KEY.
GOOGLE_EARTH_ENGINE_PROJECT=
GOOGLE_EARTH_ENGINE_KEY_FILE=secrets/earth-engine-key.json
GOOGLE_EARTH_ENGINE_KEY=
